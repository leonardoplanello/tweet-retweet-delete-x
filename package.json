{
  "name": "tweet-retweet-purge-x",
  "version": "1.0.0",
  "description": "Extensão Chrome (Manifest V3) para leitura, filtragem, seleção e exclusão em lote de Tweets e Retweets no X (Twitter) sem API oficial.",
