{
  "name": "tweet-retweet-delete-x",
  "version": "1.0.0",
  "description": "Chrome Extension (Manifest V3) to scan, filter, select, and bulk delete Tweets and Retweets on X (Twitter) without the official API.",
  "main": "dist/popup.js",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit",
    "generate-icons": "node scripts/generate-icons.js",
    "screenshots": "node scripts/capture-screenshots.js"
  },
  "keywords": [
    "twitter",
    "x",
    "tweet-deleter",
    "tweet-delete",
    "unretweet",
    "chrome-extension",
    "manifest-v3",
    "clean-architecture",
    "typescript"
  ],
  "author": "Leonardo Planello <119642102+leonardoplanello@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardoplanello/tweet-retweet-delete-x.git"
  },
  "bugs": {
    "url": "https://github.com/leonardoplanello/tweet-retweet-delete-x/issues"
  },
  "homepage": "https://github.com/leonardoplanello/tweet-retweet-delete-x#readme",
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}


