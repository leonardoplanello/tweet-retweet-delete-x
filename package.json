    "screenshots": "node scripts/capture-screenshots.js"
  },
  "keywords": [
    "twitter",
    "x",
    "tweet-deleter",
    "tweet-purge",
    "unretweet",
    "chrome-extension",
    "manifest-v3",
    "clean-architecture",
    "typescript"
  ],
