  },
  "bugs": {
    "url": "https://github.com/leonardoplanello/tweet-retweet-purge-x/issues"
  },
  "homepage": "https://github.com/leonardoplanello/tweet-retweet-purge-x#readme",
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
